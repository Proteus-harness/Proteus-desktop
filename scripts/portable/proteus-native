#!/bin/sh
# Launcher of the portable native client.
#
# Installs the bundled profiles into the agent config folder (named profiles
# are copied only when missing, their fragments and prompts are refreshed),
# then starts the client with the bundled agent server and reference module.
set -eu

here=$(dirname "$(readlink -f "$0")")
config_home=${PROTEUS_CONFIG_HOME:-"${HOME}/.config/Proteus-agent"}
if [ -f "${config_home}/environment" ]; then
  # Common environment for the GUI, owned server and process extensions.
  . "${config_home}/environment"
fi
configs="${config_home}/configs"
bundled="${here}/share/configs"

mkdir -p "${configs}"
for source in "${bundled}"/*; do
  name=$(basename "${source}")
  target="${configs}/${name}"
  if [ -d "${source}" ]; then
    # Same folder when configs is a symlink to the bundled copy.
    if [ ! "${source}" -ef "${target}" ]; then
      mkdir -p "${target}"
      cp -R "${source}/." "${target}/"
    fi
  elif [ ! -e "${target}" ]; then
    cp "${source}" "${target}"
  fi
done

export PROTEUS_BIN="${here}/bin/proteus"
export PATH="${here}/bin:${PATH}"
exec python3 "${here}/share/system_proxy.py" "${here}/bin/proteus-native" "$@"
