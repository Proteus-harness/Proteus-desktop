#!/bin/sh
# Adds Proteus to the application menu of this user. Run it again after
# moving the folder; `--remove` takes the shortcut away.
set -eu

here=$(dirname "$(readlink -f "$0")")
data=${XDG_DATA_HOME:-"${HOME}/.local/share"}
app_id=dev.proteus.native
entry="${data}/applications/${app_id}.desktop"
icon="${data}/icons/hicolor/scalable/apps/${app_id}.svg"

if [ "${1:-}" = "--remove" ]; then
  rm -f "${entry}" "${icon}"
  echo "Removed: ${entry}"
  exit 0
fi

mkdir -p "$(dirname "${entry}")" "$(dirname "${icon}")"
cp "${here}/share/icons/proteus-native.svg" "${icon}"
cat > "${entry}" <<EOF
[Desktop Entry]
Type=Application
Name=Proteus
Comment=Native client of the Proteus agent
Comment[ru]=Приложение агента Proteus
Exec="${here}/proteus-native" --choose-workspace
TryExec=${here}/proteus-native
Icon=${app_id}
Terminal=false
Categories=Development;
Keywords=Agent;AI;Chat;Coding;
StartupWMClass=${app_id}
EOF
update-desktop-database "$(dirname "${entry}")" 2>/dev/null || true
gtk-update-icon-cache -f -t "${data}/icons/hicolor" 2>/dev/null || true
echo "Installed: ${entry}"
