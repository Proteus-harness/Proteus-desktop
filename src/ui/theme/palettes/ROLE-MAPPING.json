  "families": {
    "catppuccin": {
      "sources": [
        "cat-palette",
        "cat-readme",
        "cat-ui"
      ],
      "tokens": {
        "chrome": "crust",
        "sidebar": "mantle",
        "content": "base",
        "card": "surface0",
        "popover": "surface0",
        "muted": "surface0",
        "border": "surface2 / editorHoverWidget.border"
      },
      "note": "Catppuccin VSCode default workbench roles; surface0 supplies card, muted and popup surfaces. Profile is a key in palette.json; use colors.<token>.hex. Border follows the official hover/suggest popup surface2 role rather than the accent-colored dropdown border."
    },
    "tokyonight": {
      "sources": [
        "tok-night",
        "tok-storm",
        "tok-moon",
        "tok-init",
        "tok-borders"
      ],
      "tokens": {
        "chrome": "bg_dark1",
        "sidebar": "bg_dark",
        "content": "bg",
        "card": "bg_highlight",
        "popover": "bg_highlight",
        "muted": "bg_highlight",
        "border": "border / WinSeparator"
      },
      "note": "Named Tokyo Night palette backgrounds adapted to Proteus roles. Night deep-copies storm, then overrides bg/bg_dark/bg_dark1; bg_highlight therefore comes from storm.lua. Border adapts the neutral WinSeparator token to settings frames, not the colored FloatBorder. Values are upstream-derived black=blend(bg,0.8,#000000); no Proteus runtime blending."
    },
    "gruvbox": {
      "sources": [
        "gruvbox"
      ],
      "tokens": {
        "dark": {
          "chrome": "dark0_hard",
          "sidebar": "dark0",
          "content": "dark0_soft",
          "card": "dark1",
          "popover": "dark1",
          "muted": "dark1",
          "border": "dark3 / VertSplit foreground"
        },
        "light": {
          "chrome": "light1",
          "sidebar": "light0_soft",
          "content": "light0",
          "card": "light1",
          "popover": "light1",
          "muted": "light1",
          "border": "light3 / VertSplit foreground"
        }
      },
      "note": "Explicit Proteus contrast adaptation using named Gruvbox colors, not the default Gruvbox workbench placement. Dark spans three bg0 contrast variants; Light uses light1/light0_soft/light0. Border reuses the official VertSplit bg3 foreground as a Proteus popup/field adaptation."
    },
    "everforest": {
      "sources": [
        "ever-dark",
        "ever-light",
        "ever-workbench"
      ],
      "tokens": {
        "chrome": "bg0",
        "sidebar": "bg1",
        "content": "bg",
        "card": "bg2",
        "popover": "bg2",
        "muted": "bg2",
        "border": "bg5 / dropdown.border"
      },
      "note": "Official VSCode medium background palette, following highContrast.ts chrome/sidebar/editor roles. Cards, muted and popup use the same palette bg2. Profile selects dark or light background/medium.ts. Border is dropdown.border=bg5. Moving the tab strip from editor to sidebar is a Proteus adaptation."
    },
    "solarized": {
      "sources": [
        "solar-dark",
        "solar-light"
      ],
      "tokens": {
        "dark": {
          "chrome": "peekViewEditor.background",
          "sidebar": "sideBar.background",
          "content": "editor.background",
          "card": "editor.lineHighlightBackground",
          "popover": "editor.lineHighlightBackground",
          "muted": "editor.lineHighlightBackground",
          "border": "dropdown.border"
        },
        "light": {
          "chrome": "activityBar.background",
          "sidebar": "sideBar.background",
          "content": "editor.background",
          "card": "sideBar.background",
          "popover": "sideBar.background",
          "muted": "sideBar.background",
          "border": "dropdown.border"
        }
      },
      "note": "Microsoft VSCode port. Proteus reassigns Dark peekViewEditor.background inset #10192c to chrome; this is not an original Solarized three-level workbench design. Dark cards use base02, Light cards base2."
    },
    "ayu": {
      "sources": [
        "ayu-dark",
        "ayu-light",
        "ayu-dark-yaml",
        "ayu-light-yaml"
      ],
      "tokens": {
        "chrome": "surface.sunk / titleBar.activeBackground",
        "sidebar": "surface.base / sideBar.background",
        "content": "surface.lift / editor.background",
        "card": "ui.panel.bg / editorWidget.background",
        "popover": "ui.popup.bg / menu.background",
        "muted": "ui.panel.bg / editorWidget.background",
        "border": "ui.line / dropdown.border"
      },
      "note": "Official ayu-colors semantic tokens and generated VSCode JSON. Generated JSON resolves Dark surface.sunk to #010102. Panel here means ui.panel.bg (editorWidget), not VSCode panel.background. Border is ui.line; alpha comes from upstream. Moving rail from base to sunk and tab strip from lift to base are Proteus adaptations."
    }
  },
