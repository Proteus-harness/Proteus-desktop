  "control_state_policy": {
    "baseline_commit": "715b19f10851c4efc666e6e4cb2af1bce923a7a5",
    "rule": "Normal fills and primary colors are unchanged. Explicit neutral normal/hover/pressed chains increase relative luminance in dark mode and decrease it in light mode. Secondary and button.secondary share one chain. Prefer authored neutral/source-state colors that keep text 4.5:1; where unavailable, store a documented offline neutral composition. No runtime color rewriting.",
    "compositing": "Flatten alpha states over their own normal secondary fill, and neutral fallback overlays in sRGB; round each byte half-up. Native named inputs use the pinned default-colors.json hex coordinates; resolved native HSL values are independently contrast-tested.",
    "exceptions": {
      "Catppuccin Latte": "surface1 on normal text is4.39:1, so use explicit black 3%/6% compositing instead of authored darker neutral steps.",
      "Catppuccin Mocha": "Existing source-state colors are ordered by luminance; pressed is a larger step than hover, keeping both authored colors.",
      "Gruvbox Dark": "Authored dark1/dark2/dark3 have larger perceptual steps than generated palettes; retained as part of the chosen palette."
    },
